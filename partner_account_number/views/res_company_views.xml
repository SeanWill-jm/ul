<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_partner_account_number" model="ir.ui.view">
        <field name="name">res.company.form.partner.account.number</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="partner_account_numbering"
                       string="Partner Account Numbering">
                    <field name="partner_account_prefix"
                           placeholder="e.g. 103"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_company_list_partner_account_number" model="ir.ui.view">
        <field name="name">res.company.list.partner.account.number</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="partner_account_prefix" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
