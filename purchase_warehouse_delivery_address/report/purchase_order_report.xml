<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 19.0 has two report templates: purchase.report_purchaseorder_document (PO / RFQ by
         state, action_report_purchase_order) and purchase.report_purchasequotation_document
         (dedicated RFQ action, also used by Send RFQ). Both are inherited identically.

         Edits (anchors read from 19.0 source text; runtime authoritative):
         1. Delivery Address block: after the first oe_structure inside div.page.
         2. Standard "Shipping address" (Dropship, `t t-if="o.dest_address_id"`) is hidden ONLY
            when a Delivery Address is chosen; otherwise it prints as standard.
         3. Vendor block: the contact widget no longer prints `vat` (its label is fixed to
            "VAT"); the tax number is printed right after it as "TAX ID:".
         Never remove or rewrite `class` on standard nodes (see website_sale_catalog_tiles 1.0.1). -->

    <template id="report_purchaseorder_document_warehouse_delivery_address"
              inherit_id="purchase.report_purchaseorder_document"
              name="Purchase Order - Delivery Address">
        <xpath expr="//div[hasclass('page')]/div[hasclass('oe_structure')][1]" position="after">
            <div t-if="o.po_delivery_address_id"
                 class="row mb-3"
                 name="po_delivery_address_block">
                <div class="col-6">
                    <strong class="d-block">Delivery Address</strong>
                    <div t-field="o.po_delivery_address_id"
                         t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True, "phone_icons": True}'
                         name="po_delivery_address"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-if='o.dest_address_id']" position="attributes">
            <attribute name="t-if">o.dest_address_id and not o.po_delivery_address_id</attribute>
        </xpath>
        <xpath expr="//t[@t-set='address']/div[@t-field='o.partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}</attribute>
        </xpath>
        <xpath expr="//t[@t-set='address']/div[@t-field='o.partner_id']" position="after">
            <div t-if="o.partner_id.vat" name="po_partner_tax_id">
                <strong>TAX ID:</strong> <span t-field="o.partner_id.vat"/>
            </div>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_po_delivery_address"
              inherit_id="purchase.report_purchasequotation_document"
              name="Request for Quotation - Delivery Address">
        <xpath expr="//div[hasclass('page')]/div[hasclass('oe_structure')][1]" position="after">
            <div t-if="o.po_delivery_address_id"
                 class="row mb-3"
                 name="po_delivery_address_block">
                <div class="col-6">
                    <strong class="d-block">Delivery Address</strong>
                    <div t-field="o.po_delivery_address_id"
                         t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True, "phone_icons": True}'
                         name="po_delivery_address"/>
                    <!-- The standard shipping block (hidden above) also carried the Requested
                         Ship Date on the RFQ; keep it here so the date is not lost. -->
                    <div t-if="o.date_planned" name="po_requested_ship_date">
                        <strong>Requested Ship Date:</strong>
                        <span t-field="o.date_planned" t-options="{'date_only': 'true'}"/>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-if='o.dest_address_id']" position="attributes">
            <attribute name="t-if">o.dest_address_id and not o.po_delivery_address_id</attribute>
        </xpath>
        <xpath expr="//t[@t-set='address']/div[@t-field='o.partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}</attribute>
        </xpath>
        <xpath expr="//t[@t-set='address']/div[@t-field='o.partner_id']" position="after">
            <div t-if="o.partner_id.vat" name="po_partner_tax_id">
                <strong>TAX ID:</strong> <span t-field="o.partner_id.vat"/>
            </div>
        </xpath>
    </template>
</odoo>
