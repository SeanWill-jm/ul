<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_warehouse_delivery_address"
              inherit_id="purchase.report_purchaseorder_document"
              name="Purchase Order - Warehouse Delivery Address">
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="not o.dest_address_id and o.warehouse_delivery_address_id"
                 class="row mb-4"
                 name="warehouse_delivery_address_block">
                <div class="col-6">
                    <strong>Delivery Address</strong>
                    <div t-field="o.warehouse_delivery_address_id"
                         t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'
                         name="warehouse_delivery_address"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
