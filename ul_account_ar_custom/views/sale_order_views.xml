<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation Tree -->
    <record id="view_quotation_tree_inherit_partner_state" model="ir.ui.view">
        <field name="name">sale.quotation.tree.inherit.partner.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_state_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Order Tree -->
    <record id="view_order_tree_inherit_partner_state" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.partner.state</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="partner_state_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
