<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend product template form to show 'picking' invoice policy option -->
    <record id="product_template_form_view_ul_picking_policy" model="ir.ui.view">
        <field name="name">product.template.form.ul.picking.policy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="invoice_policy" position="attributes">
                <attribute name="help">
                    Ordered Quantity: Invoice quantities ordered by the customer.
                    Delivered Quantity: Invoice quantities delivered to the customer.
                    Picked Quantities (2-Step): Invoice quantities after the pick step is validated in a 2-step delivery warehouse.
                </attribute>
            </field>
        </field>
    </record>

    <!-- Image zoom functionality for product template kanban view -->
    <record id="product_template_kanban_view_ul_zoom" model="ir.ui.view">
        <field name="name">product.template.kanban.ul.zoom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="image_1920" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='image_128']" position="attributes">
                <attribute name="options">{'zoom': true, 'preview_image': 'image_1920', 'size': [55, 55], 'img_class': 'object-fit-contain'}</attribute>
                <attribute name="class" add="o_kanban_image_zoom ul_clickable_image" separator=" "/>
            </xpath>
        </field>
    </record>

</odoo>
