<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Anchor verified against 19.0 website_sale/views/res_config_settings_views.xml:
         setting id="cart_redirect_setting" ("Add to Cart") in the eCommerce block. -->
    <record id="res_config_settings_view_form_catalog_tiles" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_sale_catalog_tiles</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="cart_redirect_setting" position="after">
                <setting id="catalog_tiles_setting" string="Catalog Tiles"
                         help="Show the internal reference, the on-hand quantity and a quantity picker on each product tile of the shop (per website).">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="tile_show_reference" class="col-lg-6 o_light_label"/>
                            <field name="tile_show_reference"/>
                        </div>
                        <div class="row mt8">
                            <label for="tile_quantity_picker" class="col-lg-6 o_light_label"/>
                            <field name="tile_quantity_picker"/>
                        </div>
                        <div class="row mt8">
                            <label for="tile_show_on_hand" class="col-lg-6 o_light_label"/>
                            <field name="tile_show_on_hand" class="o_light_label"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
